{
  "expo": {
    "name": "Pairfect",
    "slug": "Pairfect",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "pairfect",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "privacyPolicy": "https://pairfect.com.ng/privacy",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.Pairfect",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "SKAdNetworkItems": [],
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "googleServicesFile": "./android/app/google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E6F4FE"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.Pairfect",
      "versionCode": 12,
      "permissions": [
        "POST_NOTIFICATIONS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Original_Logo.png",  
          "imageWidth": 100,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/Original_Logo.png",
          "color": "#ffffff",
          "sounds": [],
          "defaultChannel": "chat-messages"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosOnly": true
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "52cdb0e5-ce26-4188-95b1-febc3d7b744f"
      },
      "router": {}
    },
    "owner": "jaycreated"
  }
}
